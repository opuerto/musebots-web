// Cloudflare Containers: the Worker in src/index.js sends every request to one container built from the repository's Dockerfile.
// Deploy from this folder with `npx wrangler deploy` (Docker must be running), or with the GitHub Actions workflow.
{
  "name": "musebots",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "containers": [
    {
      "class_name": "Band",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // 1/4 vCPU and 1 GiB. If the sound stutters, try "standard-1" (1/2 vCPU, 4 GiB): it costs more only while it is awake.
      "instance_type": "basic",
      // One band server for everyone: the performances live in its memory, so there must never be two.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BAND", "class_name": "Band" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Band"] }],
  "vars": {
    // A quarter of a CPU is enough for one or two bands at once; extra visitors are asked to try again in a minute.
    "MAX_PERFORMANCES": "2",
    // The pages allowed to open the band's WebSocket: your workers.dev address and, once you add it, your own domain.
    "ALLOWED_ORIGINS": "https://musebots.YOUR-SUBDOMAIN.workers.dev"
  }
  // Your own domain (its DNS must be on Cloudflare): uncomment, and add it to ALLOWED_ORIGINS too.
  // ,"routes": [{ "pattern": "band.puerto.is", "custom_domain": true }]
}
